# ==========================================
# exam.co Server Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/examco?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/examco?retryWrites=true&w=majority

# JWT Secrets for Teacher & Student Sessions
JWT_SECRET=super_secret_examco_teacher_jwt_key_2026
ATTEMPT_JWT_SECRET=super_secret_examco_attempt_jwt_key_2026

# Firebase Admin SDK (Used strictly for Teacher Google Sign-In verification)
# Generated from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=exam-co-proctor
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@exam-co-proctor.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# WebRTC STUN / TURN Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
